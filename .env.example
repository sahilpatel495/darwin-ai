# Verity settings. Copy this file to .env (git-ignored) and fill in at least one API key.
#   cp .env.example .env
# Every variable the app reads (backend/app/config.py) is listed here. Lines that start with #
# show the built-in default. Remove the # only when you change the value: an uncommented line
# with nothing after the = replaces the default with an empty value.

# --- Model providers ---------------------------------------------------------------------
# All models are open-weight and all of these have a free tier with no credit card.
# A provider with no key is skipped, so one key is enough; more keys mean more free quota.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# NVIDIA NIM: https://build.nvidia.com
NVIDIA_API_KEY=
# Google AI Studio (Gemma): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (":free" models, last resort): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any other OpenAI-compatible endpoint (vLLM, LM Studio, a customer's gateway). Use it in a
# chain as "custom:<model name>".
# LLM_BASE_URL=
LLM_API_KEY=

# A model running on your own machine with Ollama needs no key. Inside Docker use
# http://host.docker.internal:11434/v1 instead.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Which model does which job ----------------------------------------------------------
# A chain is an ordered, comma-separated list of provider:model. If one is rate-limited or
# down, the next is tried. Providers: groq, nvidia, gemini, openrouter, ollama, custom.
# Writes the SQL:
# LLM_SQL_CHAIN=groq:openai/gpt-oss-120b,nvidia:deepseek-ai/deepseek-v4-flash-0731,groq:qwen/qwen3.8-27b,gemini:gemma-4-31b-it,openrouter:qwen/qwen3.8-27b:free
# Writes its own SQL independently so the two results can be compared. Keep it a different
# model family from the first model in LLM_SQL_CHAIN, or agreement means little:
# LLM_CROSSCHECK_CHAIN=groq:qwen/qwen3.8-27b,nvidia:deepseek-ai/deepseek-v4-flash-0731,openrouter:z-ai/glm-5.2:free
# Phrases the answer from already-computed, already-formatted numbers (small and fast):
# LLM_NARRATE_CHAIN=groq:openai/gpt-oss-20b,gemini:gemma-4-31b-it,openrouter:google/gemma-4-31b-it:free
# "on" or "off". Off halves model usage; answers then carry no "Cross-checked" badge.
# CROSSCHECK=on

# --- Limits (what a security reviewer will ask about) ---------------------------------------
# Largest single upload, in MB. The hosted demo uses 10.
# MAX_UPLOAD_MB=25
# A query is interrupted after this many seconds.
# QUERY_TIMEOUT_S=10
# At most this many result rows are returned; the answer says when it was cut short.
# ROW_CAP=5000
# Memory and threads for each session's DuckDB. The hosted demo uses 256MB.
# DUCKDB_MEMORY_LIMIT=512MB
# DUCKDB_THREADS=2
# A session and its data are dropped after this many idle seconds (2 hours)...
# SESSION_TTL_S=7200
# ...or when more than this many sessions exist (the least recently used goes first).
# MAX_SESSIONS=20
# Questions allowed per visitor IP address per hour.
# ASKS_PER_IP_PER_HOUR=60
# Model calls allowed per day across all visitors. Protects your keys on a public URL.
# LLM_CALLS_PER_DAY=3000

# --- Paths ---------------------------------------------------------------------------------
# Scratch folder for uploads in flight and DuckDB spill files. Raw uploads are deleted as
# soon as they are loaded. The Docker image sets /tmp/verity.
# WORK_DIR=/tmp/verity
# Folder holding the sample HR files behind "Try with sample HR data".
# DEMO_DATA_DIR=demo_data
# Saves every model reply on disk so repeated eval runs cost no tokens. The eval runner sets
# this itself; leave it unset for the app.
# LLM_CACHE_DIR=
